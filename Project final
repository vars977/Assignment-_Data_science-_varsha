# ============================================================
# 1. IMPORT LIBRARIES
# ============================================================

import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler

from sklearn.cluster import KMeans, DBSCAN

from sklearn.metrics import silhouette_score

from sklearn.neighbors import NearestNeighbors

from sklearn.decomposition import PCA


# ============================================================
# 2. LOAD DATASET
# ============================================================

file_path = "marketing_campaign.xlsx"

df = pd.read_excel(file_path)


print("=" * 70)
print("CUSTOMER SEGMENTATION PROJECT")
print("=" * 70)

print("\nDataset Shape:")
print(df.shape)

print("\nFirst 5 Rows:")
print(df.head())


# ============================================================
# 3. DATA INFORMATION
# ============================================================

print("\n" + "=" * 70)
print("DATA INFORMATION")
print("=" * 70)

df.info()


# ============================================================
# 4. MISSING VALUES
# ============================================================

print("\n" + "=" * 70)
print("MISSING VALUES")
print("=" * 70)

print(df.isnull().sum())


# ============================================================
# 5. DUPLICATE CHECK
# ============================================================

print("\n" + "=" * 70)
print("DUPLICATE CHECK")
print("=" * 70)

print(
    "Number of duplicate rows:",
    df.duplicated().sum()
)


# Remove duplicates

df = df.drop_duplicates().copy()

print(
    "Shape after removing duplicates:",
    df.shape
)


# ============================================================
# 6. HANDLE MISSING VALUES
# ============================================================

# Income has missing values.
# Replace missing Income with median.

if 'Income' in df.columns:

    df['Income'] = df['Income'].fillna(
        df['Income'].median()
    )


print("\nMissing values after treatment:")

print(df.isnull().sum())


# ============================================================
# 7. CREATE AGE
# ============================================================

# Current year = 2026

df['Age'] = 2026 - df['Year_Birth']


print("\nAge Statistics:")

print(df['Age'].describe())


# ============================================================
# 8. REMOVE UNREALISTIC AGE VALUES
# ============================================================

print("\nCustomers with unrealistic age:")

print(
    df[
        (df['Age'] < 18) |
        (df['Age'] > 100)
    ][
        ['ID', 'Year_Birth', 'Age']
    ]
)


# Keep realistic ages

df = df[
    (df['Age'] >= 18) &
    (df['Age'] <= 100)
].copy()


print(
    "\nShape after age cleaning:",
    df.shape
)


# ============================================================
# 9. INCOME OUTLIER TREATMENT
# ============================================================

Q1 = df['Income'].quantile(0.25)

Q3 = df['Income'].quantile(0.75)

IQR = Q3 - Q1

lower_bound = Q1 - 1.5 * IQR

upper_bound = Q3 + 1.5 * IQR


print("\nIncome Q1:", Q1)

print("Income Q3:", Q3)

print("Income IQR:", IQR)

print("Lower Bound:", lower_bound)

print("Upper Bound:", upper_bound)


# Cap income outliers

df['Income'] = df['Income'].clip(
    lower=lower_bound,
    upper=upper_bound
)


# ============================================================
# 10. FEATURE ENGINEERING
# ============================================================


# ------------------------------------------------------------
# Total Spending
# ------------------------------------------------------------

spending_columns = [

    'MntWines',

    'MntFruits',

    'MntMeatProducts',

    'MntFishProducts',

    'MntSweetProducts',

    'MntGoldProds'

]


df['Total_Spending'] = (
    df[spending_columns]
    .sum(axis=1)
)


# ------------------------------------------------------------
# Total Purchases
# ------------------------------------------------------------

purchase_columns = [

    'NumWebPurchases',

    'NumCatalogPurchases',

    'NumStorePurchases'

]


df['Total_Purchases'] = (
    df[purchase_columns]
    .sum(axis=1)
)


# ------------------------------------------------------------
# Total Children
# ------------------------------------------------------------

df['Total_Children'] = (

    df['Kidhome'] +

    df['Teenhome']

)


# ------------------------------------------------------------
# Total Campaign Acceptance
# ------------------------------------------------------------

campaign_columns = [

    'AcceptedCmp1',

    'AcceptedCmp2',

    'AcceptedCmp3',

    'AcceptedCmp4',

    'AcceptedCmp5'

]


df['Total_Campaign_Acceptance'] = (

    df[campaign_columns]
    .sum(axis=1)

)


# ============================================================
# 11. DISPLAY ENGINEERED FEATURES
# ============================================================

print("\n" + "=" * 70)

print("ENGINEERED FEATURES")

print("=" * 70)


print(
    df[
        [
            'Age',
            'Total_Spending',
            'Total_Purchases',
            'Total_Children',
            'Total_Campaign_Acceptance'
        ]
    ].head()
)


# ============================================================
# 12. SELECT CLUSTERING FEATURES
# ============================================================

cluster_features = [

    'Income',

    'Age',

    'Recency',

    'Total_Spending',

    'Total_Purchases',

    'NumDealsPurchases',

    'NumWebVisitsMonth',

    'Total_Children',

    'Total_Campaign_Acceptance'

]


X = df[
    cluster_features
].copy()


print("\n" + "=" * 70)

print("CLUSTERING FEATURES")

print("=" * 70)

print(cluster_features)

print("\nFeature Matrix Shape:")

print(X.shape)


# ============================================================
# 13. CHECK MISSING VALUES IN CLUSTERING FEATURES
# ============================================================

print("\nMissing values in clustering features:")

print(X.isnull().sum())


# If any missing values remain, use median

X = X.fillna(
    X.median()
)


# ============================================================
# 14. STANDARDIZATION
# ============================================================

scaler = StandardScaler()


X_scaled = scaler.fit_transform(
    X
)


print("\nScaled Data Shape:")

print(X_scaled.shape)


# ============================================================
# 15. K-MEANS — ELBOW METHOD
# ============================================================

inertia_values = []

k_values = range(
    2,
    11
)


for k in k_values:

    kmeans = KMeans(

        n_clusters=k,

        random_state=42,

        n_init=10

    )

    kmeans.fit(
        X_scaled
    )

    inertia_values.append(
        kmeans.inertia_
    )


plt.figure(
    figsize=(10, 6)
)


plt.plot(

    k_values,

    inertia_values,

    marker='o'

)


plt.title(
    "Elbow Method for K-Means"
)


plt.xlabel(
    "Number of Clusters (K)"
)


plt.ylabel(
    "Inertia"
)


plt.grid(True)


plt.tight_layout()


plt.show()


# ============================================================
# 16. K-MEANS — SILHOUETTE SCORE
# ============================================================

silhouette_results = []


for k in range(
    2,
    11
):

    kmeans = KMeans(

        n_clusters=k,

        random_state=42,

        n_init=10

    )


    labels = kmeans.fit_predict(
        X_scaled
    )


    score = silhouette_score(

        X_scaled,

        labels

    )


    silhouette_results.append({

        'K': k,

        'Silhouette_Score': score

    })


silhouette_results = pd.DataFrame(
    silhouette_results
)


print("\n" + "=" * 70)

print("K-MEANS SILHOUETTE RESULTS")

print("=" * 70)


print(
    silhouette_results.round(6)
)


# ============================================================
# 17. SILHOUETTE GRAPH
# ============================================================

plt.figure(
    figsize=(10, 6)
)


plt.plot(

    silhouette_results['K'],

    silhouette_results[
        'Silhouette_Score'
    ],

    marker='o'

)


plt.title(
    "Silhouette Score for Different K Values"
)


plt.xlabel(
    "Number of Clusters"
)


plt.ylabel(
    "Silhouette Score"
)


plt.grid(True)


plt.tight_layout()


plt.show()


# ============================================================
# 18. SELECT BEST K
# ============================================================

best_k = int(

    silhouette_results.loc[

        silhouette_results[
            'Silhouette_Score'
        ].idxmax(),

        'K'

    ]

)


best_k_score = (

    silhouette_results.loc[

        silhouette_results[
            'Silhouette_Score'
        ].idxmax(),

        'Silhouette_Score'

    ]

)


print("\n" + "=" * 70)

print("BEST K-MEANS MODEL")

print("=" * 70)


print(
    "Best K:",
    best_k
)


print(
    "Best Silhouette Score:",
    round(
        best_k_score,
        6
    )
)


# ============================================================
# 19. FINAL K-MEANS MODEL
# ============================================================

final_kmeans = KMeans(

    n_clusters=best_k,

    random_state=42,

    n_init=10

)


kmeans_labels = (

    final_kmeans.fit_predict(
        X_scaled
    )

)


# Add cluster labels

df['Cluster'] = kmeans_labels


# ============================================================
# 20. K-MEANS CLUSTER COUNTS
# ============================================================

print("\n" + "=" * 70)

print("K-MEANS CLUSTER COUNTS")

print("=" * 70)


cluster_counts = (

    df['Cluster']
    .value_counts()
    .sort_index()

)


print(cluster_counts)


# ============================================================
# 21. K-MEANS CLUSTER PERCENTAGES
# ============================================================

cluster_percentages = (

    df['Cluster']
    .value_counts(
        normalize=True
    )
    .sort_index()
    * 100

)


print("\nCluster Percentages:")


print(
    cluster_percentages.round(2)
)


# ============================================================
# 22. PCA VISUALIZATION — K-MEANS
# ============================================================

pca = PCA(
    n_components=2
)


X_pca = pca.fit_transform(
    X_scaled
)


pca_kmeans = pd.DataFrame({

    'PC1':
        X_pca[:, 0],

    'PC2':
        X_pca[:, 1],

    'Cluster':
        kmeans_labels

})


plt.figure(
    figsize=(10, 7)
)


sns.scatterplot(

    data=pca_kmeans,

    x='PC1',

    y='PC2',

    hue='Cluster',

    palette='Set2',

    s=60

)


plt.title(
    "K-Means Customer Segmentation"
)


plt.xlabel(
    "Principal Component 1"
)


plt.ylabel(
    "Principal Component 2"
)


plt.legend(
    title='Cluster'
)


plt.tight_layout()


plt.show()


# ============================================================
# 23. K-MEANS CLUSTER PROFILE
# ============================================================

cluster_profile = (

    df

    .groupby('Cluster')[cluster_features]

    .mean()

    .round(2)

)


print("\n" + "=" * 70)

print("K-MEANS CUSTOMER PROFILE")

print("=" * 70)


print(cluster_profile)


# ============================================================
# 24. CLUSTER SIZE TABLE
# ============================================================

cluster_size = (

    df['Cluster']

    .value_counts()

    .sort_index()

    .reset_index()

)


cluster_size.columns = [

    'Cluster',

    'Customer_Count'

]


cluster_size[
    'Customer_Percentage'
] = (

    cluster_size[
        'Customer_Count'
    ]

    / len(df)

    * 100

).round(2)


print("\n" + "=" * 70)

print("CLUSTER SIZE")

print("=" * 70)


print(cluster_size)


# ============================================================
# 25. FINAL K-MEANS PROFILE TABLE
# ============================================================

final_profile = (

    cluster_profile

    .reset_index()

)


final_profile = final_profile.merge(

    cluster_size,

    on='Cluster'

)


final_profile = final_profile[

    [

        'Cluster',

        'Customer_Count',

        'Customer_Percentage',

        'Income',

        'Age',

        'Recency',

        'Total_Spending',

        'Total_Purchases',

        'NumDealsPurchases',

        'NumWebVisitsMonth',

        'Total_Children',

        'Total_Campaign_Acceptance'

    ]

]


print("\n" + "=" * 70)

print("FINAL K-MEANS CUSTOMER SEGMENT SUMMARY")

print("=" * 70)


print(final_profile)


# ============================================================
# 26. K-DISTANCE GRAPH FOR DBSCAN
# ============================================================

min_samples_for_graph = 5


neighbors = NearestNeighbors(

    n_neighbors=min_samples_for_graph

)


neighbors_fit = neighbors.fit(
    X_scaled
)


distances, indices = (

    neighbors_fit.kneighbors(
        X_scaled
    )

)


k_distances = np.sort(
    distances[:, -1]
)


plt.figure(
    figsize=(10, 6)
)


plt.plot(
    k_distances
)


plt.title(
    "K-Distance Graph for DBSCAN"
)


plt.xlabel(
    "Data Points"
)


plt.ylabel(
    "Distance to 5th Nearest Neighbor"
)


plt.grid(True)


plt.tight_layout()


plt.show()


# ============================================================
# 27. DBSCAN PARAMETER TESTING
# ============================================================

eps_values = [

    0.5,

    0.6,

    0.7,

    0.8,

    0.9,

    1.0,

    1.1,

    1.2,

    1.3,

    1.4,

    1.5

]


min_samples_values = [

    3,

    4,

    5,

    6,

    8,

    10

]


dbscan_results = []


for eps in eps_values:

    for min_samples in min_samples_values:


        dbscan = DBSCAN(

            eps=eps,

            min_samples=min_samples

        )


        labels = dbscan.fit_predict(
            X_scaled
        )


        # Number of clusters
        unique_labels = set(
            labels
        )


        n_clusters = len(
            unique_labels - {-1}
        )


        # Number of noise points
        n_noise = np.sum(
            labels == -1
        )


        noise_percentage = (

            n_noise /

            len(labels)

            * 100

        )


        # Calculate silhouette
        # only if at least 2 clusters exist

        non_noise_mask = (
            labels != -1
        )


        non_noise_data = (
            X_scaled[
                non_noise_mask
            ]
        )


        non_noise_labels = (
            labels[
                non_noise_mask
            ]
        )


        if (

            n_clusters >= 2

            and

            len(
                np.unique(
                    non_noise_labels
                )
            ) >= 2

        ):

            silhouette = silhouette_score(

                non_noise_data,

                non_noise_labels

            )

        else:

            silhouette = np.nan


        dbscan_results.append({

            'eps':
                eps,

            'min_samples':
                min_samples,

            'clusters':
                n_clusters,

            'noise_points':
                n_noise,

            'noise_percentage':
                round(
                    noise_percentage,
                    2
                ),

            'silhouette_score':
                silhouette

        })


dbscan_results = pd.DataFrame(
    dbscan_results
)


# ============================================================
# 28. DISPLAY DBSCAN RESULTS
# ============================================================

print("\n" + "=" * 70)

print("DBSCAN PARAMETER RESULTS")

print("=" * 70)


print(
    dbscan_results.round(4)
)


# ============================================================
# 29. FIND BEST DBSCAN PARAMETERS
# ============================================================

valid_dbscan_results = (

    dbscan_results

    .dropna(
        subset=[
            'silhouette_score'
        ]
    )

    .copy()

)


# Remove extremely high noise models

valid_dbscan_results = (

    valid_dbscan_results[

        valid_dbscan_results[
            'noise_percentage'
        ] < 50

    ]

)


if len(valid_dbscan_results) > 0:

    best_dbscan = (

        valid_dbscan_results.loc[

            valid_dbscan_results[
                'silhouette_score'
            ].idxmax()

        ]

    )


    best_eps = float(
        best_dbscan['eps']
    )


    best_min_samples = int(
        best_dbscan[
            'min_samples'
        ]
    )


else:

    best_eps = 1.5

    best_min_samples = 10


print("\n" + "=" * 70)

print("BEST DBSCAN PARAMETERS")

print("=" * 70)


print(
    "Best eps:",
    best_eps
)


print(
    "Best min_samples:",
    best_min_samples
)


# ============================================================
# 30. FINAL DBSCAN MODEL
# ============================================================

final_dbscan = DBSCAN(

    eps=best_eps,

    min_samples=best_min_samples

)


dbscan_labels = (

    final_dbscan.fit_predict(
        X_scaled
    )

)


# Add DBSCAN labels

df['DBSCAN_Cluster'] = (
    dbscan_labels
)


# ============================================================
# 31. DBSCAN CLUSTER COUNT
# ============================================================

dbscan_cluster_count = len(

    set(dbscan_labels) - {-1}

)


dbscan_noise_count = np.sum(

    dbscan_labels == -1

)


dbscan_noise_percentage = (

    dbscan_noise_count /

    len(dbscan_labels)

    * 100

)


print("\n" + "=" * 70)

print("DBSCAN FINAL RESULTS")

print("=" * 70)


print(
    "Number of DBSCAN clusters:",
    dbscan_cluster_count
)


print(
    "Noise points:",
    dbscan_noise_count
)


print(
    "Noise percentage:",
    round(
        dbscan_noise_percentage,
        2
    ),
    "%"
)


# ============================================================
# 32. DBSCAN SILHOUETTE SCORE
# ============================================================

dbscan_non_noise_mask = (

    dbscan_labels != -1

)


dbscan_X = (

    X_scaled[
        dbscan_non_noise_mask
    ]

)


dbscan_y = (

    dbscan_labels[
        dbscan_non_noise_mask
    ]

)


if len(
    np.unique(dbscan_y)
) >= 2:

    dbscan_silhouette = (

        silhouette_score(

            dbscan_X,

            dbscan_y

        )

    )

else:

    dbscan_silhouette = np.nan


print(
    "DBSCAN Silhouette Score:",
    round(
        dbscan_silhouette,
        4
    )
    if not np.isnan(
        dbscan_silhouette
    )
    else "Not available"
)


# ============================================================
# 33. DBSCAN PCA VISUALIZATION
# ============================================================

pca_dbscan = pd.DataFrame({

    'PC1':
        X_pca[:, 0],

    'PC2':
        X_pca[:, 1],

    'DBSCAN_Cluster':
        dbscan_labels

})


plt.figure(
    figsize=(10, 7)
)


sns.scatterplot(

    data=pca_dbscan,

    x='PC1',

    y='PC2',

    hue='DBSCAN_Cluster',

    palette='Set2',

    s=60

)


plt.title(
    "DBSCAN Customer Segmentation"
)


plt.xlabel(
    "Principal Component 1"
)


plt.ylabel(
    "Principal Component 2"
)


plt.legend(
    title='DBSCAN Cluster'
)


plt.tight_layout()


plt.show()


# ============================================================
# 34. DBSCAN PROFILE
# ============================================================

dbscan_customers = df[

    df['DBSCAN_Cluster'] != -1

].copy()


dbscan_profile = (

    dbscan_customers

    .groupby(
        'DBSCAN_Cluster'
    )[cluster_features]

    .mean()

    .round(2)

)


print("\n" + "=" * 70)

print("DBSCAN CUSTOMER PROFILE")

print("=" * 70)


print(dbscan_profile)


# ============================================================
# 35. DBSCAN CLUSTER SIZE
# ============================================================

dbscan_size = (

    df[
        df['DBSCAN_Cluster'] != -1
    ]

    ['DBSCAN_Cluster']

    .value_counts()

    .sort_index()

    .reset_index()

)


dbscan_size.columns = [

    'DBSCAN_Cluster',

    'Customer_Count'

]


dbscan_size[
    'Customer_Percentage'
] = (

    dbscan_size[
        'Customer_Count'
    ]

    / len(df)

    * 100

).round(2)


print("\n" + "=" * 70)

print("DBSCAN CLUSTER SIZE")

print("=" * 70)


print(dbscan_size)


# ============================================================
# 36. K-MEANS VS DBSCAN COMPARISON
# ============================================================

comparison = pd.DataFrame({

    'Model': [

        'K-Means',

        'DBSCAN'

    ],

    'Number_of_Clusters': [

        best_k,

        dbscan_cluster_count

    ],

    'Silhouette_Score': [

        best_k_score,

        dbscan_silhouette

    ],

    'Noise_Percentage': [

        0,

        dbscan_noise_percentage

    ]

})


print("\n" + "=" * 70)

print("K-MEANS VS DBSCAN")

print("=" * 70)


print(
    comparison.round(4)
)


# ============================================================
# 37. FINAL MODEL SELECTION
# ============================================================

if (

    not np.isnan(
        dbscan_silhouette
    )

    and

    dbscan_silhouette >
    best_k_score

):

    final_model = "DBSCAN"

else:

    final_model = "K-Means"


print("\n" + "=" * 70)

print("FINAL MODEL SELECTION")

print("=" * 70)


print(
    "Selected Model:",
    final_model
)


if final_model == "K-Means":

    print(
        "Reason: K-Means achieved the higher Silhouette Score "
        "and produced more interpretable customer segments."
    )

else:

    print(
        "Reason: DBSCAN achieved the higher Silhouette Score."
    )


# ============================================================
# 38. BUSINESS SEGMENT NAMES
# ============================================================

# Based on your current K-Means result:
#
# Cluster 0:
# Lower-Spending / Deal-Oriented
#
# Cluster 1:
# High-Value / High-Spending


segment_names = {

    0:
        'Lower-Spending / Deal-Oriented',

    1:
        'High-Value / High-Spending'

}


df['Customer_Segment'] = (

    df['Cluster']
    .map(segment_names)

)


# ============================================================
# 39. MANAGEMENT SUMMARY
# ============================================================

management_summary = (

    df

    .groupby(
